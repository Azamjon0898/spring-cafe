<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <form class="login-container" action="/admin/login" METHOD="POST">
    <div class="background-image-wrapper">
      <img
        src="/uploads/home-page/homepage.jpg"
        alt="Background"
        class="background-image"
      />
    </div>
    <div class="login-frame">
      <div class="login-input-frame">
        <div class="login-input-container">
          <label>Admin *</label>
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            value=""
            required
          />
        </div>
        <div class="login-input-container">
          <label>Password *</label>
          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Password"
            value=""
            required
          />
        </div>
      </div>
      <button class="login-btn btn" name="login" type="submit">Login</button>

      <!-- Alahida tugmalar -->
      <div class="button-container">
        <a href="/admin" class="home-button">Home</a>
        <a href="/admin/signup" class="signup-btn">Signup</a>
      </div>
    </div>
  </form>
</body>

<%- include('includes/footer') %>

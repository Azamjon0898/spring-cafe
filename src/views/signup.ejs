<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <div class="background-image-wrapper">
      <img
        src="/uploads/home-page/homepage.jpg"
        alt="Background"
        class="background-image"
      />
    </div>

    <form
      onsubmit="return validateSignupForm()"
      action="/admin/signup"
      method="POST"
      enctype="multipart/form-data"
    >
      <div class="signup-frame" style="width: 650px">
        <div class="signup-input-frame">
          <div class="media-frame">
            <div class="upload-container">
              <div>
                <div class="upload-img-frame">
                  <img src="/img/cafe.jpg" alt="Preview" />
                </div>
              </div>
              <div
                class="file-box bs3-primary preview-image"
                style="margin-top: 25px; display: flex"
              >
                <input
                  class="upload-name"
                  value="Choose image"
                  disabled="disabled"
                />

                <label for="input-file" class="file-input-label"
                  >Upload Image</label
                >
                <input
                  type="file"
                  id="input-file"
                  class="upload-hidden form-control-file member-image"
                  name="memberImage"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Nickname *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Enter username"
              minlength="8"
              maxlength="20"
              required
            />
          </div>

          <div class="sign-up-frame">
            <label>Phone *</label>
            <input
              type="text"
              name="memberPhone"
              class="member-phone"
              placeholder="000-0000-0000"
              maxlength="13"
              pattern="\d{3}-\d{4}-\d{4}"
              required
            />
          </div>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              minlength="8"
              maxlength="20"
              required
            />
          </div>
          <div class="sign-up-frame">
            <label>Repeat password *</label>
            <input
              type="password"
              name="confirmPassword"
              class="confirm-password"
              placeholder="Repeat password"
              minlength="8"
              maxlength="20"
              required
            />
          </div>
        </div>

        <input name="memberType" value="RESTAURANT" hidden />

        <button class="signup-btn" name="signup" type="submit">Signup</button>

        <div class="button-container">
          <a href="/admin" class="home-button">Home</a>
          <a href="/admin/login" class="login-button">Login</a>
        </div>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>

<script type="text/javascript" src="/js/signup.js"></script>
